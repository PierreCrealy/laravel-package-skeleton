{
  "name": "@pierr/laravel-package-skeleton",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:css && npm run build:js && npm run publish:assets",
    "build:css": "sass resources/scss:public --no-source-map --style=compressed",
    "build:js": "vite build",
    "dev:css": "sass resources/scss:public --no-source-map --watch",
    "dev:js": "vite build --watch",
    "publish:assets": "php vendor/bin/testbench vendor:publish --tag=laravel-package-skeleton-assets --force"
  },
  "dependencies": {
    "jquery": "^3.6.0"
  },
  "devDependencies": {
    "sass": "^1.80.0",
    "vite": "^6.0.0"
  }
}
